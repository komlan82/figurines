###> À copier dans .env.local (non versionné) puis adapter ###
# MySQL avec XAMPP/WAMP : utilisateur root sans mot de passe.
# Si vous utilisez MariaDB (XAMPP), remplacez serverVersion par ex. 10.4.32-MariaDB
DATABASE_URL="mysql://root:@127.0.0.1:3306/figurine_prenom_db?serverVersion=8.0.32&charset=utf8mb4"

# En développement les emails ne partent nulle part (transport "null").
# Pour les voir : installez Mailpit et utilisez MAILER_DSN=smtp://127.0.0.1:1025
MAILER_DSN=null://null
