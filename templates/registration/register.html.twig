{% extends 'base.html.twig' %}

{% block title %}Inscription – Figurine Collector{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">Créer un compte</h1>

                    {{ form_start(registrationForm) }}
                        {{ form_row(registrationForm.firstname) }}
                        {{ form_row(registrationForm.lastname) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.plainPassword) }}

                        <button type="submit" class="btn btn-primary w-100 mt-2">S'inscrire</button>
                    {{ form_end(registrationForm) }}

                    <p class="text-center small mt-3 mb-0">
                        Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
