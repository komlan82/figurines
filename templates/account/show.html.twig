{% extends 'base.html.twig' %}

{% block title %}Mon profil – Figurine Collector{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body p-4">
                    <img src="{{ vich_uploader_asset(user, 'imageFile') }}" alt="Image de profil"
                         class="rounded-circle border mb-3" width="150" height="150" style="object-fit: cover;">

                    <h1 class="h3">{{ user.firstname }} {{ user.lastname }}</h1>
                    <p class="text-muted mb-1">{{ user.email }}</p>
                    <p class="text-muted small">Membre depuis le {{ user.createdAt|date('d/m/Y') }}</p>

                    <a href="{{ path('app_account_edit') }}" class="btn btn-warning">Éditer mon profil</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
